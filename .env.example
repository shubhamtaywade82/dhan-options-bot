# ---- DhanHQ v2 credentials (https://api.dhan.co/v2) ----
# Client ID issued by Dhan (e.g. 1000000001)
DHAN_CLIENT_ID=
# Access token generated from web.dhan.co -> DhanHQ APIs (valid for 24 hours)
DHAN_ACCESS_TOKEN=

# ---- Telegram (optional - leave blank to disable) ----
# Create a bot with @BotFather, put the token here
TELEGRAM_BOT_TOKEN=
# Your chat id (send /start to your bot, then check getUpdates)
TELEGRAM_CHAT_ID=

# ---- Ollama / Tev1 (optional - Layer 2 model selection) ----
# Set this to enable the Tev1 strategy selector (model must be pulled first:
#   ollama pull tev1:0.8b )
# When unset, the bot uses the deterministic selector.
OLLAMA_BASE_URL=

